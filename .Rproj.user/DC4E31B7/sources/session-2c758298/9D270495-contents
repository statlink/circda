vmf.kernel <- function(y, h = "rot", ncores = 1) {
  ## x is the data
  ## h is the bandwidth you want
  p <- dim(y)[2]  ## dimensionality of the data
  n <- dim(y)[1]  ## sample size of the data
  ## thumb is either 'none' (defualt), or 'rot' (Garcia-Portugues, 2013)

  if ( h == "rot" ) {
    k <- Rfast::vmf.mle(y)$kappa  ## concentration parameter
    q <- p - 1
    if ( q == 2 )  h <- ( 8 * sinh(k)^2 / ( k * n * ( (1 + 4 * k^2) * sinh(2 * k) -  2 * k * cosh(2 * k) ) ) )^(1/6)
    if (q >= 3) {
      up <- 4 * pi^0.5 * besselI(k, (q - 1)/2, TRUE)^2
      down <- k^( (q + 1)/2 ) * n * ( 2 * q * besselI(2 * k, (q + 1)/2, TRUE) + (2 + q) * k * besselI(2 * k, (q + 3)/2, TRUE) )
      h <- ( up / down )^( 1/(4 + q) )
    }

  } else h <- h
  cpk <- (1/h^2)^(p/2 - 1) / ( (2 * pi)^(p/2) * besselI(1/h^2, p/2 - 1, TRUE) )
  com <- cpk / (n - 1)

  f <- vmf_kernel_cpp(t(y), h, com, as.integer(ncores))
  list( h = h, f = f )
}
