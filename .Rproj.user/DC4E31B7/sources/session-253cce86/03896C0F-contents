\examples{
y1 <- Rfast::rvmf(100, c(1, 0, 0), 10)
y2 <- Rfast::rvmf(100, c(0, 1, 0), 5)
y <- rbind(y1, y2)
ina <- rep(1:2, each = 100)
mod <- cv.vmfkernelda(y, ina)
}
