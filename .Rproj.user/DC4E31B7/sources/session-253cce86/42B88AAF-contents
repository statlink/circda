\seealso{
\code{\link{vmf.kernel}, \link{vm.kernel.da}
}
}

\examples{
x1 <- Rfast::rvmf(100, c(1, 0, 0), 10)
x2 <- Rfast::rvmf(100, c(0, 1, 0), 10)
x <- rbind(x1, x2)
ina <- rep(1:2, each = 100)
xnew <- Rfast::rvmf(50, c(1, 0, 0), 10)
mod <- vmf.kernel.da(xnew, x, ina, h = "rot")
table(mod$class)
mod2 <- vmf.kernel.da(xnew, x, ina, h = "rot", ncores = 2)
}
